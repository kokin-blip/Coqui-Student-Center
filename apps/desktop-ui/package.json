{
  "name": "@student-center/desktop-ui",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite --configLoader runner build",
