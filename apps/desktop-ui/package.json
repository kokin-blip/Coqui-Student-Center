    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "typescript": "5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.7"
  }
