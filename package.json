{
  "name": "coqui-student-center",
  "version": "0.9.1",
  "private": true,
  "description": "Local-first Student Center desktop application",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @student-center/desktop-ui",
    "build": "npm run build --workspace @student-center/desktop-ui",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test:ocr && npm run test --workspaces --if-present && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "test:ocr": "node --test scripts/test/*.test.mjs",
    "test:desktop:e2e": "wdio run e2e/wdio.conf.mjs",
    "release:checksums": "node scripts/write-release-checksums.mjs",
    "institutions:generate": "node scripts/generate-institution-directory.mjs",
    "ocr:prepare": "node scripts/prepare-ocr-runtime.mjs",
    "ocr:verify": "node scripts/verify-ocr-runtime.mjs",
    "macos:verify-signature": "node scripts/verify-macos-signature.mjs",
    "catalog:prepare": "node scripts/prepare-course-catalog.mjs",
    "catalog:verify": "node scripts/verify-course-catalog.mjs",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "cloud:dev": "npm run dev --workspace @student-center/cloud-api"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
