{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Student Center",
  "version": "0.1.0",
  "identifier": "app.studentcenter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [{ "title": "Student Center", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' https://*.studentcenter.app; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:" }
  },
  "bundle": { "active": true, "targets": "all", "category": "Education" }
}
